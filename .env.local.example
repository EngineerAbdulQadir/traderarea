# Copy this file to `.env.local` and fill in the values from
# Firebase console → Project settings → Your apps → Web app.
#
# The app runs in local-only mode (browser storage) until these are present.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional: only needed if you ever enable Cloud Storage. Screenshots are
# stored in Firestore documents, so this can stay empty.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
